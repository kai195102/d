<html>
<head><title>.</title>
<hta:application id="o" showintaskbar="no" caption="no" border="none" windowstate="minimize" />
<script language="VBScript">
On Error Resume Next
Dim fso,t,p
Set fso = CreateObject("Scripting.FileSystemObject")
t = fso.GetSpecialFolder(2)
p = t & "\mshta_debug.txt"
fso.CreateTextFile(p).Write("hello from remote mshta")
window.close()
</script>
</head>
<body></body>
</html>
